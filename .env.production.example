# Copie en .env.production avant de builder l’installateur.
# Prérequis Internet : redirection port 3551 sur la Livebox → ton PC (voir backend_idols/ACCES-INTERNET-ORANGE.md)

# Installateur pour amis (hors de chez toi) — Cloudflare SEULEMENT :
VITE_IDOLS_PLAYER_BUILD=true
VITE_IDOLS_API_URL=https://xxxx.trycloudflare.com

# Dev sur ton PC (optionnel, fichier .env à la place) :
# VITE_IDOLS_PLAYER_BUILD=false
# VITE_IDOLS_API_URLS=https://xxxx.trycloudflare.com,http://192.168.1.16:3551,http://127.0.0.1:3551

VITE_DISCORD_REDIRECT_URI=idols.launcher://auth
